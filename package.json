{
  "name": "masterok-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:monetization": "node scripts/monetization-dev.mjs",
    "test:monetization": "vitest run src/lib/commerce src/lib/projects/procurement.test.ts src/lib/projects/purchase-edits.test.ts",
    "prebuild": "npx tsx scripts/generate-calculators-meta.ts && npx tsx scripts/generate-route-manifest.ts",
    "build": "next build --webpack",
    "indexnow:manual": "node scripts/ping-indexnow.js",
    "verify:live": "node scripts/verify-live-seo.mjs",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit --incremental false",
    "typecheck:compat": "tsc6 --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:specs": "npx tsx scripts/sync-specs-to-dart.ts",
    "sync:parity": "npx tsx scripts/generate-parity-fixtures.ts",
    "sync:meta": "npx tsx scripts/generate-calculators-meta.ts",
    "sync:routes": "npx tsx scripts/generate-route-manifest.ts",
    "sync:all": "npm run sync:specs && npm run sync:parity && npm run sync:meta && npm run sync:routes",
    "audit:risk": "npx tsx scripts/generate-calculator-risk-register.ts",
    "test:parity": "vitest run tests/parity.test.ts",
    "blog:images:check": "node scripts/optimize-ghost-images.mjs --dry-run",
    "blog:images:webp": "node scripts/optimize-ghost-images.mjs --write-files",
    "blog:images:ghost": "node scripts/optimize-ghost-images.mjs --write-ghost",
    "analyze": "ANALYZE=true npm run build",
    "analyze:server": "ANALYZE=true next build --webpack",
    "test:e2e": "playwright test",
    "test:e2e:catalog": "playwright test e2e/catalog-smoke.spec.ts e2e/constructor-entry.spec.ts e2e/constructor-hydration.spec.ts e2e/constructor-bathroom.spec.ts e2e/constructor-planning.spec.ts e2e/constructor-purchase-edit.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/three": "0.186.0",
    "dexie": "^4.4.2",
    "exceljs": "^4.4.0",
    "html-react-parser": "^6.0.0",
    "isomorphic-dompurify": "^3.7.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "langfuse": "^3.38.20",
    "lucide-react": "^0.575.0",
    "next": "16.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.11.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "js-yaml": "4.3.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "postcss": "8.5.28",
    "nanoid": "3.3.18",
    "undici": "7.29.0",
    "dompurify": "3.4.13",
    "sharp": "0.35.4",
    "vite": "7.3.5",
    "js-yaml": "4.3.1",
    "eslint": {
      "minimatch": {
        "brace-expansion": "1.1.18"
      }
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": {
        "brace-expansion": "2.1.4"
      }
    }
  }
}
