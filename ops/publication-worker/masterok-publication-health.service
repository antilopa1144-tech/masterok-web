[Unit]
Description=Independent Masterok publication watchdog (journal only)

[Service]
Type=oneshot
User=masterok-publication
Group=masterok-publication
ExecStart=/usr/bin/python3 /opt/masterok-publication/worker.py --health
StateDirectory=masterok-publication
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=64M
CPUQuota=10%
