# Copy values into a local untracked .env.local or deployment secret store.
# Do not commit actual secrets, payment credentials, mail credentials, or personal data.
MONETIZATION_MODE=off
COMMERCE_ORIGIN=http://localhost:3460
COMMERCE_LOCAL_DATA_DIR=.commerce-data/local
COMMERCE_AUTH_SECRET=
COMMERCE_ADMIN_EMAILS=owner@masterok.test

# Required outside local simulation. PostgreSQL uses commerce_sandbox / commerce_live
# schemas automatically on the same Timeweb database; changing the mode needs a redeploy.
COMMERCE_DATABASE_URL=
# For Timeweb App Platform use the existing Resend integration with a verified sender domain.
RESEND_API_KEY=
COMMERCE_MAIL_FROM=
# SMTP is an alternative on hosts where outgoing SMTP ports are open.
COMMERCE_SMTP_URL=
COMMERCE_JOB_SECRET=

# Robokassa: configure only after a separate sandbox/live review
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_RECURRING_APPROVED=false

# Live gates: all remain false or empty until legal, fiscal and provider checks pass
COMMERCE_ALLOW_LIVE_PAYMENTS=false
COMMERCE_CHECKS_NPD_CONFIRMED=false

# Match the merchant signature algorithm. Test and live passwords are different.
ROBOKASSA_HASH_ALGORITHM=sha256
ROBOKASSA_PASSWORD3=
# Optional pinned Result2 public certificate, PEM with escaped newlines
ROBOKASSA_RESULT2_CERTIFICATE=
