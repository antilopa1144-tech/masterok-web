{
  "calculator_id": "facade-panels",
  "formula_version": "facade-panels-canonical-v3",
  "input_schema": [
    { "key": "inputMode", "default_value": 1, "min": 0, "max": 1 },
    { "key": "area", "unit": "m2", "default_value": 100, "min": 1, "max": 5000 },
    { "key": "houseLength", "unit": "m", "default_value": 10, "min": 1, "max": 200 },
    { "key": "houseWidth", "unit": "m", "default_value": 10, "min": 1, "max": 200 },
    { "key": "wallHeight", "unit": "m", "default_value": 3, "min": 1, "max": 20 },
    { "key": "openingsArea", "unit": "m2", "default_value": 10, "min": 0, "max": 2000 },
    { "key": "panelType", "default_value": 0, "min": 0, "max": 6 },
    { "key": "panelUsefulArea", "unit": "m2", "default_value": 0.84, "min": 0.01, "max": 25 },
    { "key": "reservePercent", "unit": "%", "default_value": 10, "min": 0, "max": 30 },
    { "key": "needProfile", "default_value": 1, "min": 0, "max": 1 },
    { "key": "profileStep", "unit": "m", "default_value": 0.4, "min": 0.1, "max": 2 },
    { "key": "profilePieceLength", "unit": "m", "default_value": 3, "min": 0.5, "max": 12 },
    { "key": "fastenersPerPanel", "unit": "pcs", "default_value": 0, "min": 0, "max": 100 },
    { "key": "needInsulation", "default_value": 0, "min": 0, "max": 1 },
    { "key": "insulationPackArea", "unit": "m2", "default_value": 5.76, "min": 0.1, "max": 100 },
    { "key": "externalCorners", "unit": "pcs", "default_value": 4, "min": 0, "max": 100 },
    { "key": "cornerPieceLength", "unit": "m", "default_value": 3, "min": 0.5, "max": 12 },
    { "key": "starterPieceLength", "unit": "m", "default_value": 3, "min": 0.5, "max": 12 }
  ],
  "field_factors": { "enabled": [] },
  "normative_formula": {
    "panel_types": [0, 1, 2, 3, 4, 5, 6],
    "input_modes": [0, 1]
  },
  "packaging_rules": { "unit": "шт", "package_size": 1 },
  "material_rules": {
    "panel_type_labels": {
      "0": "Виниловый сайдинг",
      "1": "Металлический сайдинг",
      "2": "Фиброцементный сайдинг",
      "3": "Деревянный блок-хаус",
      "4": "Фасадные термопанели",
      "5": "Профлист стеновой",
      "6": "HPL-панели"
    },
    "max_reserve_percent": 15
  },
  "warnings_rules": { "large_area_threshold_m2": 500 },
  "scenario_policy": {
    "contract": "min-rec-max-v1",
    "MIN": "Чистая потребность без запаса",
    "REC": "Пользовательский запас применяется один раз",
    "MAX": "Не менее 15% запаса для сложного фасада",
    "purchase_quantity": "Округление вверх до целой панели"
  }
}
