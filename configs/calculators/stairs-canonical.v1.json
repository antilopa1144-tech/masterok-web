  "field_factors": { "enabled": [] },
  "normative_formula": {
    "riser_count": "round(floor rise / target riser height) or explicit project count",
    "tread_count": "riser count minus one when the upper floor is the last tread",
    "straight_run": "tread count * tread depth",
    "incline_length": "sqrt(floor rise^2 + straight run^2)",
    "headroom_estimate": "floor rise * min(opening length / straight run, 1) - floor structure thickness"
  },
  "packaging_rules": {
    "count_package_unit": "упаковок",
    "stock_piece_unit": "заготовок",
    "concrete_order_unit": "заказов"
  },
